# Local development values only. Do not use these for a deployed environment.
POSTGRES_DB=datadesigner
POSTGRES_USER=datadesigner
POSTGRES_PASSWORD=local-development-only

# Architecture Assistant (Slice B). Disabled by default. The OpenCode password
# is server-side only and must never be exposed to the browser or the web
# service. Provide a real secret in deployed environments.
ASSISTANT_ENABLED=false
OPENCODE_PASSWORD=local-development-only
ASSISTANT_TOOL_SERVICE_TOKEN=local-development-only
# Optional previous service token accepted during rotation.
ASSISTANT_TOOL_SERVICE_TOKEN_PREVIOUS=
